# yandex-wiki-mcp — шаблон. Скопируйте в .env рядом и заполните.

# Bearer-токен HTTP-эндпоинта. Пусто = без auth (только внутренняя сеть).
MCP_AUTH_TOKEN=

# HTTP-порт MCP-сервера (по умолчанию 3001, чтобы не конфликтовать с calendar :3000)
MCP_HTTP_PORT=3001

# OAuth-токен с правом wiki:read (достаточно для read-only MCP)
YANDEX_WIKI_OAUTH_TOKEN=

# Организация (один из вариантов):
# Яндекс 360 / wiki.yandex.ru → X-Org-Id
YANDEX_WIKI_ORG_ID=
# Yandex Cloud → X-Cloud-Org-Id
# YANDEX_WIKI_CLOUD_ORG_ID=

# oauth (default) | iam
# YANDEX_WIKI_AUTH_MODE=oauth

# Базовый URL API (обычно не менять)
# YANDEX_WIKI_API_BASE_URL=https://api.wiki.yandex.net

# Read-only MCP: только get_page + list_descendants (по умолчанию true)
WIKI_READ_ONLY=true
