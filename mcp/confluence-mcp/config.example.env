# Скопируй в .env и заполни. Те же email+token, что для Jira.
# Можно заполнить CONFLUENCE_* или (fallback) те же JIRA_* из jira-mcp/.env.
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=paste_same_token_as_jira
CONFLUENCE_SPACE_KEY=ONB
# MCP_HOST=127.0.0.1
MCP_PORT=9103
