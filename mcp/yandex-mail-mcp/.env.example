# yandex-mail-mcp — шаблон. Скопируйте в .env рядом и заполните.

# Bearer-токен HTTP-эндпоинта. Пусто = без auth (только внутренняя сеть).
MCP_AUTH_TOKEN=

# HTTP-порт (хост). В Docker внутри контейнера всегда 3000.
MCP_HTTP_PORT=3002

# Ящик Яндекс.Почты
YANDEX_MAIL_LOGIN=you@yandex.ru

# Один из способов авторизации (OAuth предпочтительнее):
# OAuth: scopes mail:imap_ro (чтение) + mail:smtp (отправка)
YANDEX_MAIL_OAUTH_TOKEN=
# Или пароль приложения (id.yandex.ru → Пароли приложений → Почта)
# YANDEX_MAIL_APP_PASSWORD=

# Опционально: хосты/порты (по умолчанию imap.yandex.com:993, smtp.yandex.com:465)
# YANDEX_MAIL_IMAP_HOST=imap.yandex.com
# YANDEX_MAIL_IMAP_PORT=993
# YANDEX_MAIL_SMTP_HOST=smtp.yandex.com
# YANDEX_MAIL_SMTP_PORT=465

# false = отключить tool yandex_mail_send (только чтение)
MAIL_SEND_ENABLED=true

# При Kaspersky/SSL-инспекции положите CA в certs/corp-ca.pem
