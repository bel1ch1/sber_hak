# onboarding-mcp — шаблон. Скопируйте в .env рядом.

# Обфускация PII: агент видит только обезличенные id сотрудников/новичков,
# а имена/почты/телефоны живут в data/*.json внутри MCP и не уходят в LLM.
# true (по умолчанию) = включено.
ONBOARDING_OBFUSCATION=true

# Пути к мок-датасетам (по умолчанию data/employees.json и data/newbies.json)
# ONBOARDING_EMPLOYEES_PATH=data/employees.json
# ONBOARDING_NEWBIES_PATH=data/newbies.json

# «Сегодня» для расчёта прогресса/ворнингов (по умолчанию — системная дата).
# Удобно фиксировать для демо. Формат YYYY-MM-DD.
# ONBOARDING_TODAY=2026-07-17

# HTTP transport (optional): npm run server:http
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3005
# MCP_AUTH_TOKEN=
