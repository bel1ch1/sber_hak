# Gmail API OAuth (Desktop / Web client from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: override mailbox email (otherwise taken from Gmail profile)
# GMAIL_USER=

# Send gate (same as yandex-mail-mcp)
MAIL_SEND_ENABLED=true
MAIL_OBFUSCATION=true

# Optional: custom recipients CSV (default: ./recipients.csv)
# RECIPIENT_DIRECTORY_CSV=

# MCP HTTP (docker-compose sets these)
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3000
# MCP_AUTH_TOKEN=