# Скопируй в .env и заполни. Режим mock работает без Jira.
# --- режим ---
JIRA_MODE=mock                 # mock | real
# --- Jira Cloud (для JIRA_MODE=real) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=paste_api_token_from_id.atlassian.com
JIRA_PROJECT_KEY=PAY
# --- MCP-сервер ---
MCP_PORT=9101
