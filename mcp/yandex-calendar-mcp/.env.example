# yandex-calendar-mcp — шаблон. Скопируйте в .env рядом и заполните.

# Bearer-токен HTTP-эндпоинта. Пусто = без auth (только внутренняя сеть).
# Включить обратно: openssl rand -hex 32 и подставить значение.
MCP_AUTH_TOKEN=

# CalDAV Яндекса: логин и пароль приложения (id.yandex.ru → пароли приложений).
YANDEX_LOGIN=
YANDEX_APP_PASSWORD=
# Опционально: явные URL, если автодискавери не подходит.
# YANDEX_CALDAV_URL=https://caldav.yandex.ru/
# YANDEX_CALDAV_CALENDAR_URL=

# При Kaspersky/SSL-инспекции положите CA в certs/corp-ca.pem —
# npm-скрипты подхватят его через with-ca.cmd (NODE_EXTRA_CA_CERTS).
