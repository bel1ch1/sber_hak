# =============================================================================
# Ouroboros — конфигурация окружения (хакатон)
# =============================================================================
#
# Быстрый старт:
#   1. cp agent.env .env          # или скопируйте вручную на Windows
#   2. Заполните секреты ниже (или позже в Settings UI агента)
#   3. git clone --branch ouroboros --single-branch https://github.com/razzant/ouroboros.git
#   4. docker compose up -d --build
#   5. Откройте http://localhost:8765
#
# Разработка пайплайна и MCP — в локальных папках (не в git):
#   skills/   → playbook'и и extension/script skills
#   mcp/      → исходники MCP-серверов
#   memory/   → identity.md, knowledge/
#   workspace/→ рабочие файлы агента (Files tab)
#
# =============================================================================

# --- Сеть и доступ ---
OUROBOROS_NETWORK_PASSWORD=hackathon-change-me
OUROBOROS_SERVER_HOST=0.0.0.0
OUROBOROS_SERVER_PORT=8765
OUROBOROS_DATA_DIR=/data
OUROBOROS_FILE_BROWSER_DEFAULT=/workspace

# --- Провайдер LLM (один из вариантов; можно задать в Settings UI) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GIGACHAT_CREDENTIALS=

# --- MCP-серверы онбординга ---
# MCP_ENABLED=true и список серверов сохраняются владельцем в
# Settings → Advanced → MCP. После добавления выполните /restart.
# URL ниже предназначены для Ouroboros в общей docker compose сети:
#
# Mail + calendar: Google only (Yandex MCP disabled / compose profile "yandex").
# {"id":"gmail","name":"gmail","url":"http://gmail-mcp:3000/mcp","transport":"streamable_http","enabled":true}
# {"id":"google_calendar","name":"google-calendar","url":"http://google-calendar-mcp:3000/mcp","transport":"streamable_http","enabled":true}
# {"id":"buddy","name":"buddy","url":"http://buddy-mcp:3008/mcp","transport":"streamable_http","enabled":true}
# {"id":"stepik","name":"stepik","url":"http://stepik-mcp:3000/mcp","transport":"streamable_http","enabled":true}
# {"id":"jira","name":"jira","url":"http://jira-mcp:9101/mcp","transport":"streamable_http","enabled":true}
# {"id":"wiki","name":"wiki","url":"http://wiki-mock-mcp:9102/mcp","transport":"streamable_http","enabled":true}
# {"id":"confluence","name":"confluence","url":"http://confluence-mcp:9103/mcp","transport":"streamable_http","enabled":true}
#
# При запуске Ouroboros вне compose используйте host.docker.internal и
# опубликованные порты: gmail 3009, google-calendar 3010, buddy 3008,
# stepik 3007, jira 9101, wiki 9102, confluence 9103.
# Секреты MCP остаются в mcp/<server>/.env и никогда не копируются сюда.

# --- Локальные пути проекта (хост) ---
HACKATHON_SKILLS_DIR=skills
HACKATHON_MCP_DIR=mcp
HACKATHON_MEMORY_DIR=memory
HACKATHON_WORKSPACE_DIR=workspace

# --- Режим review skills (Advisory — быстрее для разработки) ---
# OUROBOROS_SKILL_REVIEW_MODE=advisory
